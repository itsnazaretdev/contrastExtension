{
  "name": "contrast-checker",
  "displayName": "Contrast Checker",
  "description": "Instantly calculate WCAG color contrast ratio from any text selection in your editor",
  "version": "0.1.0",
  "publisher": "itsnazaretdev",
  "icon": "logoCC.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsnazaretdev/contrastExtension.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "contrast-checker.calculateContrast",
        "title": "Check Accessibility Contrast",
        "category": "Contrast Checker"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "contrast-checker.calculateContrast",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "vscode-test",
    "package": "pnpm exec vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "1.80.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.x",
    "eslint": "10.5.0",
    "globals": "14.0.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^2.0.2"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.6"
  }
}
